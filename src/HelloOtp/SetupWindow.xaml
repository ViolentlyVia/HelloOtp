<Window x:Class="HelloOtp.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelloOtp recovery code" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Save your recovery code" />
        <TextBlock Margin="0,8,0,12" TextWrapping="Wrap"
                   Text="If Windows Hello is reset or Windows is reinstalled, this code is the only way back into your vault. It will not be shown again. Write it down and keep it somewhere safe." />
        <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="15" TextAlignment="Center" Padding="6,10" />
        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Copy" Click="OnCopy" />
        <CheckBox x:Name="SavedBox" Margin="0,16,0,0" Content="I have saved this code" Checked="OnSavedChanged" Unchecked="OnSavedChanged" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="ContinueButton" Margin="8,0,0,0" Content="Create vault" IsEnabled="False" Click="OnContinue" />
        </StackPanel>
    </StackPanel>
</Window>
