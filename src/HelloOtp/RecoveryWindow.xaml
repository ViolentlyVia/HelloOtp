<Window x:Class="HelloOtp.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelloOtp recovery" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" Text="Restore your vault" />
        <TextBlock x:Name="ReasonText" Margin="0,8,0,12" TextWrapping="Wrap" />
        <TextBlock Margin="0,0,0,4" Text="Recovery code" />
        <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="15" />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Visibility="Collapsed" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="ActionButton" Margin="8,0,0,0" Content="Restore" IsDefault="True" Click="OnRestore" />
        </StackPanel>
    </StackPanel>
</Window>
