<Window x:Class="HelloOtp.SnipOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelloOtp scan" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="Black" Cursor="Cross"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp"
        MouseRightButtonUp="OnCancelClick" KeyDown="OnKeyDown">
    <Grid x:Name="Root">
        <Image x:Name="Screen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="Selection" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="Collapsed" />
        </Canvas>
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="14,8" CornerRadius="8"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="14"
                       Text="Drag around the QR code. Press Esc to cancel." />
        </Border>
    </Grid>
</Window>
