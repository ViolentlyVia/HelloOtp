<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HelloOtp</AssemblyName>
    <RootNamespace>HelloOtp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only for the tray icon. Its namespaces would clash with WPF if imported everywhere. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\HelloOtp.Core\HelloOtp.Core.csproj" />
    <InternalsVisibleTo Include="HelloOtp.Tests" />
  </ItemGroup>

</Project>
